# 유튜브 쇼츠 자동 수집 (--source youtube). Google Cloud 콘솔에서 YouTube Data API v3 키 발급
YOUTUBE_API_KEY=
# 내 인스타그램 계정 릴스 댓글 (--source instagram)
IG_ACCESS_TOKEN=
IG_USER_ID=
# 내가 직접 플레이·녹화할 수 있는 게임 (검수 기준, 쉼표 구분)
MY_GAMES=Grow a Garden,99 Nights in the Forest
# 선택: SKILL.md 를 채운 뒤 LLM 모드로 돌리려면
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# 답글 모드: 내 유튜브 채널 (읽기는 API 키, 답글 게시는 OAuth 토큰 필요)
YOUTUBE_CHANNEL_ID=
YOUTUBE_OAUTH_TOKEN=
